# AWS
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# Local Postgres service (docker-compose.yml)
POSTGRES_DB=media_tool
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database / Queue
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/media_tool
# Example remote RDS format:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@media-tool.c1cywo6eqqag.ap-southeast-2.rds.amazonaws.com:5432/postgres?sslmode=verify-full&sslrootcert=system
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=media-queue

# Runtime
APP_ENV=development
MEDIA_ROOT=/data/media
MAX_IMAGE_WIDTH=1920
DEFAULT_WATERMARK=Media Tool
JWT_SECRET=dev-guest-secret-change-me
JWT_ALGORITHM=HS256
API_CORS_ORIGINS=["http://localhost:33001","http://127.0.0.1:33001"]

# Frontend container
API_INTERNAL_BASE_URL=http://api:8000
